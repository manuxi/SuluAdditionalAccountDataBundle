{
    "name": "manuxi/sulu-additional-account-data-bundle",
    "description": "Store additional data to accounts like registration court/number, descriptor/claim and openings",
    "type": "symfony-bundle",
    "keywords": [
        "sulu",
        "suluCms",
        "additional account data"
    ],
    "homepage": "https://github.com/manuxi/SuluAdditionalAccountDataBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Manuxi",
            "email": "manu@bytefresser.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/doctrine-bundle": "^2.13",
        "sulu/sulu": "^3.0.0@dev",
        "symfony/config": "^7.3",
        "symfony/dependency-injection": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/http-foundation": "^7.3",
        "symfony/http-kernel": "^7.3",
        "symfony/intl": "^7.3",
        "symfony/translation": "^7.3",
        "symfony/security-bundle": "^7.3"
    },
    "require-dev": {
        "jackalope/jackalope-doctrine-dbal": "^1.10 || ^2.0",
        "phpspec/prophecy-phpunit": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.1",
        "symfony/browser-kit": "^7.3",
        "symfony/phpunit-bridge": "^7.3",
        "symfony/console": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluAdditionalAccountDataBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluAdditionalAccountDataBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        }
    }
}
